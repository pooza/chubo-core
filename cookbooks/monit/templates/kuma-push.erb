#!/bin/sh
# ⚠ chubo が生成する。手で編集しない（cookbooks/monit/freebsd.rb）。
#
# monit の総合状態を Uptime Kuma の push モニタへ送る（pooza/chubo2#244）。
#
# ⚠⚠ **monit の `then alert` には宛先が無い。**そのため
# **2026-08-04（gomander）と 2026-09-17（shallu）の 2 回、ディスク満杯を取り逃がした。**
# syslog には 30 秒おきに出ていたが、誰にも届いていない。
#
# 🔴 **push モニタは「ハートビートが途切れたら DOWN」という向き。**
# だから失敗時だけ送るのでは足りず、**正常時も送る**。
# ⚠ これは欠点ではなく利点で、**monit 自身が死んだ / ノードが落ちた場合も DOWN になる。**
# `then alert` は monit が生きていることが前提だが、こちらはその前提も監視できる。
#
# ⚠ `periodic frequently`（*/5）から走るので送信間隔は 5 分。
#   Kuma 側の interval も 300s に揃えてある（ずれると 1 回の取りこぼしが DOWN になる）。

set -u

TOKEN='<%= @token %>'
BASE='<%= @base %>'

# ⚠⚠ **status は $2 で見る。**サービス名に空白は入れていないので、
# 2 番目のフィールドが Status 列の先頭になる。`OK` 以外はすべて異常として拾う
# （`Does not exist` / `Resource limit matched` などは複数語だが、先頭語で判別できる）。
# ⚠ 先頭 2 行は「Monit x.y uptime: ...」とヘッダなので落とす。
bad=$(monit summary -B 2>/dev/null \
  | awk 'NR > 2 && $2 != "OK" { printf "%s%s(%s)", sep, $1, $2; sep = " " }')

# ⚠⚠ **再起動待ちも同じ口に乗せる（pooza/chubo2#227）。**
# `reboot_required` は「失敗」ではないので Sentry には上がらず、
# **writersBASE 側では 1 年 23 週ぶん黙って育っていた。**単独のモニタを増やすのではなく、
# ノードの総合状態へ混ぜる（#227 のコメントで両者が合意した形）。
#
# ⚠ **FreeBSD には `reboot-required` に相当する仕組みが無い**ので、
# 導入済みカーネル（`freebsd-version -k`）と稼働中（`uname -r`）の差で見る。
# ⚠⚠ **`sec` の抽出を `.*sec = ` で書かないこと。**`kern.boottime` は
# `{ sec = ..., usec = ... }` なので、貪欲マッチが `usec` のほうを拾う
# （`tools/reboot-sweep.rb` が 2026-09-19 まで同じ誤りで全 FreeBSD を 20,712 日と出していた）。
installed=$(freebsd-version -k 2>/dev/null)
running=$(uname -r)
pending=''
up_days=0
if [ -n "${installed}" ] && [ "${installed}" != "${running}" ]; then
  boot=$(sysctl -n kern.boottime | sed -n 's/^{ *sec = \([0-9]*\).*/\1/p')
  up_days=$(( ( $(date +%s) - ${boot:-0} ) / 86400 ))
  pending="要再起動(${running}→${installed}/稼働${up_days}日)"
fi

# 🔴 **溜まった時点で初めて DOWN にする。**直近の 1 世代で鳴らすと、
# 「鳴っているが対処しなくてよいもの」を作ることになり、また読まれなくなる。
# ⚠ しきい値は `tools/reboot-sweep.rb` の A（🔴）と同じ日数に揃えてある。
# ⚠ 稼働日数は「待っている日数」そのものではない（いつ入ったかは分からない）。
#   reboot-sweep も同じ近似を使っているので、揃えてある。
if [ -n "${bad}" ]; then
  status=down
  msg="${bad}${pending:+ ${pending}}"
elif [ -n "${pending}" ] && [ "${up_days}" -ge <%= @reboot_stale_days %> ]; then
  status=down
  msg="${pending}"
elif [ -n "${pending}" ]; then
  status=up
  msg="OK ${pending}"
else
  status=up
  msg=OK
fi

# ⚠ 失敗しても periodic 全体を落とさない。届かないこと自体は
#   Kuma 側でハートビート切れとして検知される。
curl -fsS --max-time 20 --get \
  --data-urlencode "status=${status}" \
  --data-urlencode "msg=${msg}" \
  "${BASE}/${TOKEN}" > /dev/null 2>&1 || exit 0
