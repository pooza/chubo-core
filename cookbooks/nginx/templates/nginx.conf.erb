<%# worker_processes を 1 に固定していると、コア数に関係なく 1 プロセスで TLS 終端と
    HTTP/2 を捌くことになる。2026-08-02 のキュアスタ！高負荷（約 5,000 req/分・504 が
    808 件）では 4 vCPU の gomander が 1 worker のままだった。既定を auto（= コア数）に
    し、事情のあるノードだけ node yaml の nginx.worker_processes で上書きする。 -%>
worker_processes <%= node.dig('nginx', 'worker_processes') || 'auto' %>;
<% if node.platform == 'freebsd' -%>
user www;
<% else -%>
user www-data;
<% end -%>

events {
  worker_connections 1024;
  multi_accept on;
}

http {
  include mime.types;
  default_type application/octet-stream;
  sendfile on;
  keepalive_timeout 70;
  client_max_body_size 0;
  gzip on;
  access_log off;
  error_log syslog:server=127.0.0.1,tag=nginx info;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

<% real_ip_from = node.dig('nginx', 'real_ip_from') || [] -%>
<% unless real_ip_from.empty? -%>
  # 前段に別の nginx が居る構成（ステージングの層2 = noah）では、$remote_addr が
  # 常にその前段になる。IP ベースの ACL とアクセスログのために、信頼できる前段から
  # 来た X-Forwarded-For で実クライアント IP を復元する。
  # ※ itamae のテンプレート評価では ActiveSupport が読まれないので present? は使えない。
<% real_ip_from.each do |addr| -%>
  set_real_ip_from <%= addr %>;
<% end -%>
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;
<% end -%>

  server {
    listen 80;
    listen [::]:80;
    location / {
<% if node.platform == 'freebsd' -%>
      root /usr/local/www/nginx;
<% else -%>
      root /var/www/html;
<% end -%>
    }
  }

<% if node.platform == 'freebsd' -%>
  include /usr/local/etc/nginx/servers/*.conf;
<% else -%>
  include /etc/nginx/servers/*.conf;
<% end -%>
}
