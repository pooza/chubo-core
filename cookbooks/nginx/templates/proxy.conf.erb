server {
  listen 80;
  listen [::]:80;
  server_name <%= @proxy['host'] %>;
  access_log syslog:server=127.0.0.1,tag=<%= @proxy['tag'] %>,severity=info combined;

  location /.well-known/acme-challenge/ {
    root <%= @docroot %>;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}
<% if @tls -%>

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name <%= @proxy['host'] %>;
  access_log syslog:server=127.0.0.1,tag=<%= @proxy['tag'] %>,severity=info combined;

  ssl_protocols TLSv1.3 TLSv1.2;
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;
  ssl_certificate <%= @letsencrypt_dir %>/live/<%= @proxy['host'] %>/fullchain.pem;
  ssl_certificate_key <%= @letsencrypt_dir %>/live/<%= @proxy['host'] %>/privkey.pem;
  add_header Strict-Transport-Security max-age=63072000;

<% if @proxy['redirect'] -%>
  location / {
    return 302 <%= @proxy['redirect'] %>;
  }
<% else -%>
  location / {
    proxy_pass http://<%= @proxy['backend'] %>;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
<% end -%>
}
<% else -%>

# ⚠ <%= @letsencrypt_dir %>/live/<%= @proxy['host'] %>/fullchain.pem がまだ無いので
# 443 のブロックを出していない。存在しない証明書を指すと nginx が丸ごと起動できなくなる。
# 上の :80 が ACME の HTTP-01 を受けるので、certbot が発行できたら次の適用で 443 が生える。
<% end -%>
