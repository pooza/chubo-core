# /etc/crontab: system-wide crontab

SHELL=/bin/sh
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
CRON=1

<%# ⚠ 分は rand ではなくノード名から決定的に導く。理由は cron.rb を参照（pooza/chubo2#121）。 -%>
<%= @minutes['hourly'] %> * * * * root cd / && run-parts /etc/cron.hourly > /dev/null
<%= @minutes['daily'] %> 6 * * * root test -x /usr/sbin/anacron || ( cd / && run-parts /etc/cron.daily > /dev/null )
<%= @minutes['weekly'] %> 6 * * 7 root test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.weekly )
<%= @minutes['monthly'] %> 6 1 * * root test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.monthly )
