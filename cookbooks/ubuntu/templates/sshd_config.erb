Port 22
Protocol 2
SyslogFacility AUTHPRIV
LogLevel INFO

# Authentication:
PermitRootLogin no
StrictModes yes
<%# ⚠ ログインさせたいだけのサービスアカウントを sudo グループへ入れて回避しないこと。 -%>
<%# ssh.allow_groups にそのアカウント専用のグループを足す（pooza/chubo2#156）。 -%>
AllowGroups <%= [node.dig('wheel', 'group'), node.dig('sudo', 'group'), *Array(node.dig('ssh', 'allow_groups'))].compact.uniq.join(' ') %>
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
HostbasedAuthentication no
PermitEmptyPasswords no
PasswordAuthentication no
ChallengeResponseAuthentication no
KerberosAuthentication no
UsePAM no

AllowAgentForwarding yes
AllowTcpForwarding yes
X11Forwarding no
PrintMotd yes
UseDNS no

Subsystem sftp /usr/lib/openssh/sftp-server -u 002 -l ERROR
