# ⚠⚠ **このファイルは chubo-core が生成する。**以前は anacron パッケージの既定を
# そのまま使っており、**`/etc/crontab` 側にも同じ `periodic daily/weekly/monthly` が
# 居たため、3 台とも 1 日 2 回ずつ走っていた**（pooza/chubo2#243）。
# 実行の面は anacron 側に一本化し、crontab 側は anacron が無いときだけ走る形にした。
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin

# ⚠ **delay（分）はノード名から決定的に導く。**cron 側の分と同じ導出なので、
# 「anacron へ寄せると全機が 00:0x に固まる」という #243 の懸念はここで解消する。
# ⚠ anacron は spool にロックを持つので、`*/5 * * * * anacron` で何度呼ばれても
# 待機中のジョブが二重に走ることはない。
# days	delay				id		command
1	<%= @minutes['daily'] %>	daily		periodic daily
7	<%= @minutes['weekly'] %>	weekly		periodic weekly
30	<%= @minutes['monthly'] %>	monthly		periodic monthly
