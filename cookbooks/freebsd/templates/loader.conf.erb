autoboot_delay="3"

kern.geom.label.disk_ident.enable="0"
kern.geom.label.gptid.enable="0"
vfs.zfs.prefetch_disable="1"
vfs.zfs.min_auto_ashift="12"
<%# 未指定なら書かない（ARC の上限は自動）。空の値を書くと、宣言していない機に `vfs.zfs.arc_max=""` が残っていた -%>
<% if node.dig('zfs', 'arc_max') -%>
vfs.zfs.arc_max="<%= node.dig('zfs', 'arc_max') %>"
<% end -%>
<% if node.dig('zfs', 'arc_dnode_limit') -%>
vfs.zfs.arc.dnode_limit="<%= node.dig('zfs', 'arc_dnode_limit') %>"
<% end -%>
<%# `loader.console` を false にすると書かない（ローダの既定の画面に出る。VNC のコンソールで起動メニューを見る VPS 向け） -%>
<% console = node.dig('loader', 'console') -%>
<% unless console == false -%>
console="<%= console || 'comconsole' %>"
<% end -%>
virtio_load="YES"
virtio_blk_load="YES"
virtio_pci_load="YES"
virtio_net_load="YES"
cryptodev_load="YES"
zfs_load="YES"
