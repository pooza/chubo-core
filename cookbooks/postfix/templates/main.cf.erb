<%#
  ⚠ 宣言 (postfix.myhostname) を nodename より先に見ること。
  create_node_data が nodename を必ず書き込むので、逆順にすると `||` の右辺に到達せず
  node yaml の宣言が丸ごと死ぬ。実際 shallu は宣言も実機も mstdn.b-shock.org なのに、
  レシピを流すと shallu.b-shock.co.jp に書き換わる状態だった (pooza/chubo2#121)。
-%>
myhostname = <%= node.dig('postfix', 'myhostname') || node.nodename %>
inet_protocols = all
compatibility_level = 3.6
alias_maps = hash:<%= ::File.join(node.dig('postfix', 'dir'), 'aliases') %>
unknown_local_recipient_reject_code = 550
<%#
  差出人のサブドメインを親へ寄せる（root@host.example.com → root@example.com）。
  SendGrid は From のサブドメインに親の認証済みドメインを当てず sendgrid.net で署名するので、
  親の DMARC が reject だと受け取り拒否になる (pooza/chubo2#289)。
  既定の masquerade_classes は envelope_recipient を含まないので、ローカル配送の宛先は変わらない。
-%>
<% if node.dig('postfix', 'masquerade_domains') -%>
masquerade_domains = <%= Array(node.dig('postfix', 'masquerade_domains')).join(' ') %>
<% end -%>

# SASL
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:<%= ::File.join(node.dig('postfix', 'dir'), 'sasl/passwd') %>
smtp_sasl_tls_security_options = noanonymous
smtp_sasl_mechanism_filter = plain

# Relay
relayhost = [smtp.sendgrid.net]:587
smtp_tls_security_level = may
